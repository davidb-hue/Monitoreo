# Copia este archivo a  .env  (en la misma carpeta) y completa los valores.
# docker compose lee .env automáticamente. NO subas tu .env a Git.

# Secreto para proteger los PIN (obligatorio). Genera uno largo y guárdalo bien.
# Si lo cambias después, todos los PIN dejan de funcionar y hay que reasignarlos.
#   PowerShell: $b=New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Git Bash / Mac / Linux:  openssl rand -base64 48
PEPPER=CAMBIA-ESTO-POR-UN-SECRETO-LARGO

# Contraseña de la base de datos local (puedes dejarla así para uso en tu red interna).
DB_PASSWORD=pizarra_local
