# Copia este archivo a .env y ajusta. NO lo subas a Git.
PORT=3000
# Neon > Dashboard > Connect: copia la cadena de conexión (usa la "pooled" si despliegas en Vercel).
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Secreto que se mezcla con la sal de cada PIN. Genera uno largo y aleatorio.
# ¡Si lo cambias o lo pierdes, todos los PIN dejan de funcionar y hay que reasignarlos!
PEPPER=cambia-esto-por-un-secreto-largo-y-aleatorio
# Solo si el frontend se aloja en otro dominio (p. ej. otro proyecto de Vercel): su URL exacta, sin barra final.
# CORS_ORIGIN=https://monitoreo-web.vercel.app
